   "source": [
    "import re\n",
    "\n",
    "# Example text with an SSN pattern\n",
    "text = \"what can this number be used for? 123-45-6789\"\n",
    "\n",
    "# Redact any SSN-like pattern\n",
    "redacted_text = re.sub(r\"\\b\\d{3}-\\d{2}-\\d{4}\\b\", \"***\", text)\n",
    "\n",
    "print(\"Original:\", text)\n",
    "print(\"Redacted:\", redacted_text)"
   ]
